{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": ["harness/skills"]
  },
  "permission": {
    "edit": "ask",
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow",
      "**/.env.sample": "allow",
      "**/.env.template": "allow"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git remote*": "allow",
      "git ls-files*": "allow"
    },
    "webfetch": "ask",
    "websearch": "ask"
  }
}
